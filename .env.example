# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Onde encontrar: painel do Supabase -> Project Settings -> API Keys.
#
# Use a chave PUBLICÁVEL (sb_publishable_... ou "anon public").
# Nunca use aqui a chave "secret" / service_role.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
